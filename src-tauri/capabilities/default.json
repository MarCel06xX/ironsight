{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: scan events, the app's own commands (validated in Rust), update check/install and restart.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-adapters",
    "allow-start-scan",
    "allow-stop-scan",
    "allow-load-settings",
    "allow-save-settings",
    "allow-open-in-browser",
    "allow-open-remote-desktop",
    "allow-open-file-share",
    "allow-wake-on-lan",
    "allow-export-results",
    "allow-app-info",
    "allow-open-release-page",
    "allow-import-scan",
    "allow-forget-known-devices",
    "allow-scan-host-ports",
    "updater:default",
    "process:allow-restart"
  ]
}
