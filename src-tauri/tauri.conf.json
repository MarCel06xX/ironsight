{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ironsight",
  "version": "0.4.0",
  "identifier": "io.github.marcel06xx.ironsight",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ironsight",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 500,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "license": "MIT OR Apache-2.0",
    "publisher": "MarCel06xX",
    "copyright": "Copyright (c) 2026 MarCel06xX. Licensed under MIT OR Apache-2.0.",
    "homepage": "https://github.com/MarCel06xX/ironsight",
    "category": "Utility",
    "shortDescription": "Network scanner",
    "longDescription": "Open-source desktop network scanner: host discovery, port scanning, device information and export.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0MjREMDJFMzQ2RkQ1QUIKUldTcjFXODBMdEFrUkRoZkdURXdKWDd2S0UvNW5BNWg4Um5xL2o1QXhvRmg4TktjcG5Rek5KRFoK",
      "endpoints": [
        "https://github.com/MarCel06xX/ironsight/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
